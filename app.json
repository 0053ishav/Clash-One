{
  "expo": {
    "name": "Clash One",
    "slug": "clash-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clashone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0e1c3e",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.strngelabs.clashone"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0e1c3e",
          "dark": {
            "backgroundColor": "#0e1c3e"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0e1c3e"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BuilderStatusWidget",
              "label": "Builder Status",
              "description": "Track your next free builder with live countdown and progress.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "previewImage": "./assets/images/widget/builderStatusWidget.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MultiAccountWidget",
              "label": "All Accounts",
              "description": "View all your accounts and see which upgrade finishes first.",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/images/widget/builder.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LabWidget",
              "label": "Laboratory",
              "description": "Track your current research and remaining time.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/images/widget/lab.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PetWidget",
              "label": "Pets",
              "description": "Track your pet upgrades and remaining time.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/images/widget/pet.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon-hammer.png",
          "color": "#0e1c3e"
        }
      ],
      "expo-sqlite",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89d6cd7f-510d-44cb-8806-055429b40a81"
      }
    },
    "owner": "0007ishav"
  }
}